{
  "commands": {
    "sudo *": "halt",
    "rm -rf /*": "halt",
    "git push --force *": "deny",
    "git add *": "ask",
    "git commit *": "ask",
    "git push *": "ask",
    "git status *": "yes-i-am-very-sure",
    "git log *": "yes-i-am-very-sure",
    "git diff *": "yes-i-am-very-sure"
  },
  "paths": {
    "~/.ssh/**": "deny",
    "~/.aws/**": "deny",
    "~/.gnupg/**": "deny",
    "**/.env": "ask"
  },
  "tools": {},
  "readonly": true,
  "ui": {
    "position": "editor"
  }
}
