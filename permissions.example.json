{
  "default": "ask",
  "tools": {
    "read": "allow",
    "ls": "allow",
    "find": "allow",
    "grep": "allow",
    "edit": "ask",
    "write": "ask"
  },
  "external_directory": {
    "~/projects/*": "allow",
    "*": "ask"
  },
  "readonly_commands": "allow",
  "bash": {
    "git status *": "allow",
    "git log *": "allow",
    "git diff *": "allow",
    "sudo *": "deny",
    "*": "ask"
  },
  "ui": {
    "position": "editor"
  }
}
